# ============================================================
# JV CONTROLS — .gitignore
# ============================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Production builds
dist/
frontend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime and temp files
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# AI / Gemini tooling
.gemini/

# Coverage and testing artifacts
coverage/
.nyc_output/
*.lcov

# Misc
*.bak
*.orig
